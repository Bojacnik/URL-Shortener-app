<Project Sdk="Microsoft.NET.Sdk">
  <!-- Windows, Linux and macOS app. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>UrlShortener</AssemblyName>
    <RootNamespace>UrlShortener.Desktop</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Smaller self-contained downloads: unused framework/Avalonia code is trimmed away and the single file is
       compressed. TrimMode "partial" only trims libraries marked as trim-safe, so the app's own code is untouched. -->
  <PropertyGroup Condition="'$(SelfContained)' == 'true'">
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\UrlShortener.UI\UrlShortener.UI.csproj" />
  </ItemGroup>
</Project>
