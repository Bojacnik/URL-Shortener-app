<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:UrlShortener.App.ViewModels"
        xmlns:prov="using:UrlShortener.Core.Providers"
        xmlns:conv="using:UrlShortener.App.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="760"
        x:Class="UrlShortener.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/app.png"
        Title="URL Shortener"
        Width="600" Height="780" MinWidth="440" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppWindowBackground}">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+Shift+C" Command="{Binding CopyResultCommand}" />
        <KeyBinding Gesture="Escape" Command="{Binding ShortenCancelCommand}" />
    </Window.KeyBindings>

    <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="20" RowSpacing="14">

        <!-- Header -->
        <Grid ColumnDefinitions="*,Auto" Grid.Row="0">
            <StackPanel Spacing="2">
                <TextBlock Text="URL Shortener" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Classes="caption" Text="Paste a long link, get a short one. Free public services, no account." />
            </StackPanel>
            <ComboBox Grid.Column="1" VerticalAlignment="Center" MinWidth="110"
                      ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}"
                      ToolTip.Tip="Theme" />
        </Grid>

        <!-- Input -->
        <Border Grid.Row="1" Classes="card">
            <StackPanel Spacing="10">
                <TextBlock Classes="section" Text="Long URL" />
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                    <TextBox x:Name="UrlBox" Text="{Binding InputUrl}"
                             PlaceholderText="https://example.com/a/very/long/link?with=parameters"
                             AutomationProperties.Name="Long URL">
                        <TextBox.KeyBindings>
                            <KeyBinding Gesture="Enter" Command="{Binding ShortenCommand}" />
                        </TextBox.KeyBindings>
                    </TextBox>
                    <Button Grid.Column="1" Content="Paste" Command="{Binding PasteCommand}"
                            ToolTip.Tip="Paste from clipboard" />
                    <Button Grid.Column="2" Content="Clear" Command="{Binding ClearInputCommand}" />
                </Grid>
                <TextBlock Classes="error" Text="{Binding InputHint}" IsVisible="{Binding InputHint, Converter={x:Static ObjectConverters.IsNotNull}}" />

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <StackPanel Spacing="4">
                        <TextBlock Classes="caption" Text="Service" />
                        <ComboBox ItemsSource="{Binding Providers}" SelectedItem="{Binding SelectedProvider}"
                                  HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="prov:IShortenerProvider">
                                    <StackPanel Spacing="1">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Description}" Classes="caption" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Bottom">
                        <CheckBox Content="Custom alias" IsChecked="{Binding UseAlias}" IsEnabled="{Binding AliasSupported}" />
                    </StackPanel>
                </Grid>

                <StackPanel Spacing="4" IsVisible="{Binding UseAlias}">
                    <TextBox Text="{Binding Alias}" PlaceholderText="my_link"
                             AutomationProperties.Name="Custom alias">
                        <TextBox.InnerLeftContent>
                            <TextBlock Text="{Binding SelectedProvider.DisplayName, StringFormat='{}https://{0}/'}"
                                       VerticalAlignment="Center" Margin="10,0,0,0" Opacity="0.6" />
                        </TextBox.InnerLeftContent>
                        <TextBox.KeyBindings>
                            <KeyBinding Gesture="Enter" Command="{Binding ShortenCommand}" />
                        </TextBox.KeyBindings>
                    </TextBox>
                    <TextBlock Classes="error" Text="{Binding AliasHint}" IsVisible="{Binding AliasHint, Converter={x:Static ObjectConverters.IsNotNull}}" />
                </StackPanel>

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Button Classes="accent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Content="Shorten" Command="{Binding ShortenCommand}" Padding="0,8" />
                    <Button Grid.Column="1" Content="Cancel" Command="{Binding ShortenCancelCommand}"
                            IsVisible="{Binding IsBusy}" />
                </Grid>
                <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" />

                <Expander Header="Options" HorizontalAlignment="Stretch">
                    <StackPanel Spacing="6">
                        <CheckBox IsChecked="{Binding AutoFallback}"
                                  Content="If the service is down, automatically try the others" />
                        <CheckBox IsChecked="{Binding CopyAutomatically}"
                                  Content="Copy the short link to the clipboard right away" />
                    </StackPanel>
                </Expander>

                <Border IsVisible="{Binding HasStatus}"
                        Classes="status" Classes.error="{Binding IsError}"
                        Classes.success="{Binding IsSuccess}" Classes.info="{Binding IsInfo}">
                    <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </Border>

        <!-- Result -->
        <Border Grid.Row="2" Classes="card" IsVisible="{Binding HasResult}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <StackPanel Spacing="8" VerticalAlignment="Center">
                    <TextBlock Classes="section" Text="Short link" />
                    <SelectableTextBlock Text="{Binding ShortUrl}" FontSize="20" FontWeight="SemiBold"
                                         Foreground="{DynamicResource AppLinkText}" />
                    <TextBlock Text="{Binding ResultLongUrl}" Classes="caption" TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding ResultLongUrl}" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button Content="Copy" Command="{Binding CopyResultCommand}" ToolTip.Tip="Ctrl+Shift+C" />
                        <Button Content="Open in browser" Command="{Binding OpenResultCommand}" />
                    </StackPanel>
                </StackPanel>
                <Border Grid.Column="1" Background="White" CornerRadius="6" Padding="6"
                        ToolTip.Tip="Scan to open the short link">
                    <Image Source="{Binding QrCodePng, Converter={x:Static conv:PngBytesToBitmapConverter.Instance}}"
                           Width="120" Height="120" RenderOptions.BitmapInterpolationMode="None" />
                </Border>
            </Grid>
        </Border>

        <!-- History -->
        <Border Grid.Row="3" Classes="card">
            <Grid RowDefinitions="Auto,*" RowSpacing="10">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                    <TextBlock Classes="section" Text="History" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{Binding HistoryFilter}" PlaceholderText="Search history"
                             IsVisible="{Binding !HistoryIsEmpty}" />
                    <Button Grid.Column="2" Content="Clear all" Command="{Binding ClearHistoryCommand}"
                            IsVisible="{Binding !HistoryIsEmpty}" />
                </Grid>

                <TextBlock Grid.Row="1" Classes="caption" IsVisible="{Binding HistoryIsEmpty}"
                           Text="Links you shorten show up here, saved on this computer." />

                <ListBox x:Name="HistoryList" Grid.Row="1" ItemsSource="{Binding History}"
                         IsVisible="{Binding !HistoryIsEmpty}" Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:HistoryItemViewModel">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <StackPanel Spacing="1">
                                    <TextBlock Text="{Binding ShortUrl}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding LongUrl}" Classes="caption"
                                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding LongUrl}" />
                                    <TextBlock Classes="caption" FontSize="11">
                                        <Run Text="{Binding ProviderId}" />
                                        <Run Text=" · " />
                                        <Run Text="{Binding When}" />
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <Button Classes="icon" Content="Copy"
                                            Command="{Binding $parent[ListBox].((vm:MainViewModel)DataContext).CopyHistoryItemCommand}"
                                            CommandParameter="{Binding}" />
                                    <Button Classes="icon" Content="Open"
                                            Command="{Binding $parent[ListBox].((vm:MainViewModel)DataContext).OpenHistoryItemCommand}"
                                            CommandParameter="{Binding}" />
                                    <Button Classes="icon" Content="✕" ToolTip.Tip="Remove from history"
                                            Command="{Binding $parent[ListBox].((vm:MainViewModel)DataContext).RemoveHistoryItemCommand}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</Window>
