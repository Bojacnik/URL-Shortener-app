<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="UrlShortener.UI.App"
             RequestedThemeVariant="Default">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://UrlShortener.UI/Styles/Icons.axaml" />
                <ResourceInclude Source="avares://UrlShortener.UI/Styles/ControlThemes.axaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Brand gradient, same in both themes -->
            <LinearGradientBrush x:Key="BrandGradient" StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Offset="0" Color="#6366F1" />
                <GradientStop Offset="1" Color="#A855F7" />
            </LinearGradientBrush>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="Bg" Color="#F5F6FA" />
                    <SolidColorBrush x:Key="Surface" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="SurfaceAlt" Color="#F0F1F6" />
                    <SolidColorBrush x:Key="SurfaceHover" Color="#E7E9F1" />
                    <SolidColorBrush x:Key="Stroke" Color="#E4E6EE" />
                    <SolidColorBrush x:Key="Ink" Color="#14151C" />
                    <SolidColorBrush x:Key="Muted" Color="#6A6F82" />
                    <SolidColorBrush x:Key="Accent" Color="#5558E8" />
                    <SolidColorBrush x:Key="AccentSoft" Color="#ECECFE" />
                    <SolidColorBrush x:Key="AccentSoftHover" Color="#E0E0FD" />
                    <SolidColorBrush x:Key="AccentText" Color="#4446D0" />
                    <SolidColorBrush x:Key="Danger" Color="#D92D3A" />
                    <SolidColorBrush x:Key="DangerSoft" Color="#FDECEE" />
                    <SolidColorBrush x:Key="Success" Color="#12A150" />
                    <SolidColorBrush x:Key="SuccessSoft" Color="#E3F6EA" />
                    <SolidColorBrush x:Key="Warn" Color="#B45309" />
                    <SolidColorBrush x:Key="WarnSoft" Color="#FEF3E2" />
                    <SolidColorBrush x:Key="ToastBg" Color="#1D1F28" />
                    <SolidColorBrush x:Key="ToastFg" Color="#F5F6FA" />
                    <BoxShadows x:Key="CardShadow">0 1 2 0 #0D14151C, 0 10 30 -8 #263B3D8F</BoxShadows>
                    <BoxShadows x:Key="ButtonShadow">0 6 18 -6 #995558E8</BoxShadows>
                    <BoxShadows x:Key="ButtonShadowHover">0 10 24 -6 #CC5558E8</BoxShadows>
                    <BoxShadows x:Key="SegmentShadow">0 1 3 0 #1F14151C</BoxShadows>
                    <SolidColorBrush x:Key="SegmentSelected" Color="#FFFFFF" />
                    <LinearGradientBrush x:Key="HeroGlow" StartPoint="50%,0%" EndPoint="50%,100%">
                        <GradientStop Offset="0" Color="#336366F1" />
                        <GradientStop Offset="1" Color="#006366F1" />
                    </LinearGradientBrush>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="Bg" Color="#0D0E13" />
                    <SolidColorBrush x:Key="Surface" Color="#16181F" />
                    <SolidColorBrush x:Key="SurfaceAlt" Color="#1E2029" />
                    <SolidColorBrush x:Key="SurfaceHover" Color="#262935" />
                    <SolidColorBrush x:Key="Stroke" Color="#262935" />
                    <SolidColorBrush x:Key="Ink" Color="#ECEDF4" />
                    <SolidColorBrush x:Key="Muted" Color="#8C91A6" />
                    <SolidColorBrush x:Key="Accent" Color="#7C7FFF" />
                    <SolidColorBrush x:Key="AccentSoft" Color="#22244A" />
                    <SolidColorBrush x:Key="AccentSoftHover" Color="#2C2F5C" />
                    <SolidColorBrush x:Key="AccentText" Color="#A9ABFF" />
                    <SolidColorBrush x:Key="Danger" Color="#FF6B78" />
                    <SolidColorBrush x:Key="DangerSoft" Color="#3A1D22" />
                    <SolidColorBrush x:Key="Success" Color="#3DD68C" />
                    <SolidColorBrush x:Key="SuccessSoft" Color="#15301F" />
                    <SolidColorBrush x:Key="Warn" Color="#FBBF5C" />
                    <SolidColorBrush x:Key="WarnSoft" Color="#3A2C14" />
                    <SolidColorBrush x:Key="ToastBg" Color="#ECEDF4" />
                    <SolidColorBrush x:Key="ToastFg" Color="#14151C" />
                    <BoxShadows x:Key="CardShadow">0 10 30 -10 #80000000</BoxShadows>
                    <BoxShadows x:Key="ButtonShadow">0 6 18 -6 #807C7FFF</BoxShadows>
                    <BoxShadows x:Key="ButtonShadowHover">0 10 26 -6 #B37C7FFF</BoxShadows>
                    <BoxShadows x:Key="SegmentShadow">0 1 3 0 #66000000</BoxShadows>
                    <SolidColorBrush x:Key="SegmentSelected" Color="#30333F" />
                    <LinearGradientBrush x:Key="HeroGlow" StartPoint="50%,0%" EndPoint="50%,100%">
                        <GradientStop Offset="0" Color="#406366F1" />
                        <GradientStop Offset="1" Color="#006366F1" />
                    </LinearGradientBrush>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme>
            <FluentTheme.Palettes>
                <ColorPaletteResources x:Key="Light" Accent="#5558E8" />
                <ColorPaletteResources x:Key="Dark" Accent="#7C7FFF" />
            </FluentTheme.Palettes>
        </FluentTheme>
        <StyleInclude Source="avares://UrlShortener.UI/Styles/AppStyles.axaml" />
    </Application.Styles>
</Application>
