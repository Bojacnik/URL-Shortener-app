<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:UrlShortener.UI.ViewModels"
             xmlns:prov="using:UrlShortener.Core.Providers"
             xmlns:conv="using:UrlShortener.UI.Converters"
             xmlns:l="using:UrlShortener.UI.Localization"
             xmlns:sys="using:System"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="420" d:DesignHeight="860"
             x:Class="UrlShortener.UI.Views.MainView"
             x:DataType="vm:MainViewModel"
             FlowDirection="{Binding FlowDirection}"
             Background="{DynamicResource Bg}">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <UserControl.KeyBindings>
        <KeyBinding Gesture="Ctrl+Shift+C" Command="{Binding CopyResultCommand}" />
        <KeyBinding Gesture="Escape" Command="{Binding ShortenCancelCommand}" />
    </UserControl.KeyBindings>

    <Panel x:Name="Root">
        <!-- soft brand glow behind the header -->
        <Border Height="340" VerticalAlignment="Top" Background="{DynamicResource HeroGlow}" IsHitTestVisible="False" />

        <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="ContentStack" MaxWidth="580" Margin="18,14,18,40" Spacing="18">

                <!-- ===== Header ===== -->
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <Border Width="38" Height="38" CornerRadius="12" Background="{StaticResource BrandGradient}"
                            BoxShadow="{DynamicResource ButtonShadow}">
                        <PathIcon Data="{StaticResource Icon.Link}" Width="20" Height="20" Foreground="White" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{l:T App.Title}" FontWeight="SemiBold" FontSize="15" Foreground="{DynamicResource Ink}" />
                        <TextBlock Text="{l:T App.Tagline}" Classes="muted small" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button Grid.Column="2" Classes="icon" ToolTip.Tip="{l:T Settings.Title}" AutomationProperties.Name="{l:T Settings.Title}">
                        <PathIcon Data="{StaticResource Icon.Tune}" />
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedRight" FlyoutPresenterClasses="settings">
                                <StackPanel Spacing="16" Width="300" FlowDirection="{Binding FlowDirection}">
                                    <TextBlock Text="{l:T Settings.Title}" Classes="h2" />
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="{l:T Settings.Language}" Classes="label" />
                                        <ComboBox x:Name="LanguagePicker" ItemsSource="{Binding LanguageChoices}"
                                                  SelectedItem="{Binding SelectedLanguageChoice}" HorizontalAlignment="Stretch"
                                                  MaxDropDownHeight="360">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:Choice">
                                                    <TextBlock Text="{Binding Label}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="{l:T Settings.Appearance}" Classes="label" />
                                        <ListBox ItemsSource="{Binding ThemeChoices}" SelectedItem="{Binding SelectedThemeChoice}"
                                                 ItemContainerTheme="{StaticResource ChipItem}" Background="Transparent" Margin="0,0,0,-8">
                                            <ListBox.ItemsPanel>
                                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                            </ListBox.ItemsPanel>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:Choice">
                                                    <TextBlock Text="{Binding Label}" />
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </StackPanel>
                                    <ToggleSwitch IsChecked="{Binding AutoFallback}" OnContent="" OffContent=""
                                                  Content="{l:T Settings.Fallback}" />
                                    <ToggleSwitch IsChecked="{Binding CopyAutomatically}" OnContent="" OffContent=""
                                                  Content="{l:T Settings.AutoCopy}" />
                                    <ToggleSwitch IsChecked="{Binding CheckForUpdates}" OnContent="" OffContent=""
                                                  Content="{l:T Settings.UpdateCheck}" />
                                    <Border Classes="banner info" IsVisible="{Binding IsDesktop}">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                            <PathIcon Data="{StaticResource Icon.Info}" Width="16" Height="16" VerticalAlignment="Top" />
                                            <TextBlock Grid.Column="1" Text="{l:T Settings.QuickTip}" FontSize="12.5" TextWrapping="Wrap" />
                                        </Grid>
                                    </Border>
                                    <Border Height="1" Background="{DynamicResource Stroke}" />
                                    <TextBlock Classes="muted small" TextWrapping="Wrap" Text="{Binding AboutText}" />
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </Grid>

                <!-- ===== Update available ===== -->
                <Border Classes="banner info pop" IsVisible="{Binding HasUpdate}" Padding="12,8">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                        <PathIcon Data="{StaticResource Icon.Download}" Width="16" Height="16" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding UpdateText}" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center" />
                        <Button Grid.Column="2" Classes="link" Content="{l:T Update.Download}" Command="{Binding OpenUpdateCommand}" />
                        <Button Grid.Column="3" Classes="icon" Command="{Binding DismissUpdateCommand}"
                                ToolTip.Tip="{l:T Update.Later}" AutomationProperties.Name="{l:T Update.Later}">
                            <PathIcon Data="{StaticResource Icon.Close}" Width="14" Height="14" />
                        </Button>
                    </Grid>
                </Border>

                <!-- ===== Hero ===== -->
                <StackPanel Spacing="6" Margin="2,10,2,0">
                    <!-- Runs on one line: line breaks between them would add spaces (wrong for Japanese, Chinese, Hindi …) -->
                    <TextBlock Classes="h1" TextWrapping="Wrap"><Run Text="{l:T Hero.TitleStart}" /><Run Text="{l:T Hero.TitleAccent}" Foreground="{DynamicResource AccentText}" /><Run Text="{l:T Hero.TitleEnd}" /></TextBlock>
                    <TextBlock Classes="muted" FontSize="14.5" TextWrapping="Wrap" Text="{l:T Hero.Subtitle}" />
                </StackPanel>

                <!-- ===== Mode switcher ===== -->
                <Border Classes="segments">
                    <ListBox x:Name="ModePicker" AutomationProperties.Name="{l:T Mode.Shorten}" ItemsSource="{Binding ModeChoices}" SelectedItem="{Binding SelectedModeChoice}"
                             ItemContainerTheme="{StaticResource SegmentItem}" Background="Transparent">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:Choice">
                                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <!-- ===== Link found on the clipboard (desktop) ===== -->
                <Border x:Name="ClipboardBanner" Classes="banner info pop" IsVisible="{Binding HasClipboardSuggestion}" Padding="12,8">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
                        <PathIcon Data="{StaticResource Icon.Paste}" Width="16" Height="16" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{l:T Clipboard.Suggest}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding ClipboardSuggestionDisplay}" FontSize="12" Opacity="0.75" TextTrimming="CharacterEllipsis"
                                       FlowDirection="LeftToRight" HorizontalAlignment="Left" />
                        </StackPanel>
                        <Button Grid.Column="2" Classes="soft" Padding="12,6" Content="{l:T Clipboard.Use}"
                                Command="{Binding UseClipboardSuggestionCommand}" VerticalAlignment="Center" />
                        <Button Grid.Column="3" Classes="icon" Command="{Binding DismissClipboardSuggestionCommand}" VerticalAlignment="Center"
                                ToolTip.Tip="{l:T Common.Dismiss}" AutomationProperties.Name="{l:T Common.Dismiss}">
                            <PathIcon Data="{StaticResource Icon.Close}" Width="14" Height="14" />
                        </Button>
                    </Grid>
                </Border>

                <!-- ===== Input card ===== -->
                <Border Classes="card">
                    <StackPanel Spacing="16">

                        <!-- Shorten: one link -->
                        <StackPanel Spacing="8" IsVisible="{Binding IsShortenMode}">
                            <TextBox x:Name="UrlBox" Classes="big" Classes.invalid="{Binding InputHint, Converter={x:Static ObjectConverters.IsNotNull}}"
                                     Text="{Binding InputUrl}" PlaceholderText="{l:T Input.Placeholder}"
                                     FlowDirection="LeftToRight" AutomationProperties.Name="{l:T Input.Placeholder}">
                                <TextBox.InnerLeftContent>
                                    <PathIcon Data="{StaticResource Icon.Link}" Width="18" Height="18" Margin="14,0,4,0"
                                              Foreground="{DynamicResource Muted}" />
                                </TextBox.InnerLeftContent>
                                <TextBox.InnerRightContent>
                                    <Panel Margin="0,0,7,0" VerticalAlignment="Center">
                                        <Button Classes="soft" Padding="11,7" Command="{Binding PasteCommand}"
                                                IsVisible="{Binding !HasInput}" ToolTip.Tip="{l:T Input.PasteTip}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <PathIcon Data="{StaticResource Icon.Paste}" Width="14" Height="14" />
                                                <TextBlock Text="{l:T Input.Paste}" FontSize="13" />
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="icon" Command="{Binding ClearInputCommand}" IsVisible="{Binding HasInput}"
                                                ToolTip.Tip="{l:T Input.Clear}" AutomationProperties.Name="{l:T Input.Clear}">
                                            <PathIcon Data="{StaticResource Icon.Close}" Width="16" Height="16" />
                                        </Button>
                                    </Panel>
                                </TextBox.InnerRightContent>
                                <TextBox.KeyBindings>
                                    <KeyBinding Gesture="Enter" Command="{Binding ShortenCommand}" />
                                </TextBox.KeyBindings>
                            </TextBox>
                            <TextBlock Classes="error pop" Margin="4,0,0,0" Text="{Binding InputHint}"
                                       IsVisible="{Binding InputHint, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            <Border Classes="banner info pop" IsVisible="{Binding InputLooksShort}" Padding="12,8">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                    <PathIcon Data="{StaticResource Icon.Info}" Width="16" Height="16" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{l:T Input.LooksShort}" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    <Button Grid.Column="2" Classes="link" Content="{l:T Input.ExpandIt}" Command="{Binding ExpandInputCommand}" />
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- Batch: many links -->
                        <StackPanel Spacing="8" IsVisible="{Binding IsBatchMode}">
                            <TextBox x:Name="BatchBox" Classes="big multiline" Text="{Binding Batch.Input}"
                                     PlaceholderText="{l:T Batch.Placeholder}" FlowDirection="LeftToRight"
                                     AutomationProperties.Name="{l:T Batch.Placeholder}" />
                            <Grid ColumnDefinitions="*,Auto" Margin="4,0">
                                <TextBlock Classes="muted small" Text="{Binding Batch.CountText}" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Classes="link" Content="{l:T Batch.Clear}" Command="{Binding Batch.ClearCommand}"
                                        IsVisible="{Binding Batch.LinkCount}" Padding="4,0" />
                            </Grid>
                            <TextBlock Classes="error pop" Margin="4,0" Text="{Binding Batch.LimitText}" IsVisible="{Binding Batch.OverLimit}" />
                        </StackPanel>

                        <!-- Expand: follow a short link -->
                        <StackPanel Spacing="8" IsVisible="{Binding IsExpandMode}">
                            <TextBlock Classes="muted" Text="{l:T Expand.Intro}" TextWrapping="Wrap" Margin="2,0,2,4" />
                            <TextBox x:Name="ExpandBox" Classes="big" Classes.invalid="{Binding Expand.InputHint, Converter={x:Static ObjectConverters.IsNotNull}}"
                                     Text="{Binding Expand.Input}" PlaceholderText="{l:T Expand.Placeholder}"
                                     FlowDirection="LeftToRight" AutomationProperties.Name="{l:T Expand.Placeholder}">
                                <TextBox.InnerLeftContent>
                                    <PathIcon Data="{StaticResource Icon.Search}" Width="18" Height="18" Margin="14,0,4,0"
                                              Foreground="{DynamicResource Muted}" />
                                </TextBox.InnerLeftContent>
                                <TextBox.InnerRightContent>
                                    <Panel Margin="0,0,7,0" VerticalAlignment="Center">
                                        <Button Classes="soft" Padding="11,7" Command="{Binding Expand.PasteCommand}"
                                                IsVisible="{Binding !Expand.HasInput}" ToolTip.Tip="{l:T Input.PasteTip}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <PathIcon Data="{StaticResource Icon.Paste}" Width="14" Height="14" />
                                                <TextBlock Text="{l:T Input.Paste}" FontSize="13" />
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="icon" Command="{Binding Expand.ClearCommand}" IsVisible="{Binding Expand.HasInput}"
                                                ToolTip.Tip="{l:T Input.Clear}" AutomationProperties.Name="{l:T Input.Clear}">
                                            <PathIcon Data="{StaticResource Icon.Close}" Width="16" Height="16" />
                                        </Button>
                                    </Panel>
                                </TextBox.InnerRightContent>
                                <TextBox.KeyBindings>
                                    <KeyBinding Gesture="Enter" Command="{Binding Expand.ExpandCommand}" />
                                </TextBox.KeyBindings>
                            </TextBox>
                            <TextBlock Classes="error pop" Margin="4,0,0,0" Text="{Binding Expand.InputHint}"
                                       IsVisible="{Binding Expand.InputHint, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        </StackPanel>

                        <!-- Service picker (Shorten and Batch) -->
                        <StackPanel Spacing="8" IsVisible="{Binding !IsExpandMode}">
                            <TextBlock Text="{l:T Service.Label}" Classes="label" Margin="2,0,0,0" />
                            <ListBox x:Name="ServicePicker" AutomationProperties.Name="{l:T Service.Label}" ItemsSource="{Binding Providers}" SelectedItem="{Binding SelectedProvider}"
                                     ItemContainerTheme="{StaticResource ChipItem}" Background="Transparent" Margin="0,0,0,-8">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="prov:IShortenerProvider">
                                        <TextBlock Text="{Binding DisplayName}" FlowDirection="LeftToRight" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Classes="muted small" Margin="2,0,0,0" TextWrapping="Wrap"
                                       Text="{Binding SelectedProviderDescription}" />
                        </StackPanel>

                        <!-- Custom alias (Shorten) -->
                        <StackPanel Spacing="8">
                            <StackPanel.IsVisible>
                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                    <Binding Path="AliasSupported" />
                                    <Binding Path="IsShortenMode" />
                                </MultiBinding>
                            </StackPanel.IsVisible>
                            <Button Classes="link" Classes.open="{Binding UseAlias}" Command="{Binding ToggleAliasCommand}"
                                    HorizontalAlignment="Left" Margin="-2,0,0,0">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <PathIcon Data="{StaticResource Icon.Pencil}" Width="14" Height="14" />
                                    <TextBlock Text="{l:T Alias.Toggle}" />
                                    <PathIcon Classes="chevron" Data="{StaticResource Icon.ChevronDown}" Width="16" Height="16" />
                                </StackPanel>
                            </Button>
                            <StackPanel Classes="pop" Spacing="6" IsVisible="{Binding UseAlias}">
                                <TextBox x:Name="AliasBox" Classes="big compact"
                                         Classes.invalid="{Binding AliasHint, Converter={x:Static ObjectConverters.IsNotNull}}"
                                         Text="{Binding Alias}" PlaceholderText="{l:T Alias.Placeholder}"
                                         FlowDirection="LeftToRight" AutomationProperties.Name="{l:T Alias.Toggle}">
                                    <TextBox.InnerLeftContent>
                                        <TextBlock Text="{Binding AliasPrefix}" VerticalAlignment="Center" Margin="14,0,0,0"
                                                   Foreground="{DynamicResource Muted}" />
                                    </TextBox.InnerLeftContent>
                                    <TextBox.KeyBindings>
                                        <KeyBinding Gesture="Enter" Command="{Binding ShortenCommand}" />
                                    </TextBox.KeyBindings>
                                </TextBox>
                                <TextBlock Classes="error pop" Margin="4,0,0,0" Text="{Binding AliasHint}"
                                           IsVisible="{Binding AliasHint, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Main buttons, one per mode -->
                        <Button x:Name="ShortenButton" Classes="primary" Classes.busy="{Binding IsBusy}"
                                Command="{Binding ShortenCommand}" IsVisible="{Binding IsShortenMode}">
                            <Panel>
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" IsVisible="{Binding !IsBusy}">
                                    <TextBlock Text="{l:T Shorten.Button}" VerticalAlignment="Center" />
                                    <PathIcon Classes="flip" Data="{StaticResource Icon.ArrowRight}" Width="18" Height="18" Foreground="White" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" IsVisible="{Binding IsBusy}">
                                    <Arc Classes="spinner" Width="18" Height="18" StartAngle="0" SweepAngle="270"
                                         Stroke="White" StrokeThickness="2.5" StrokeLineCap="Round" VerticalAlignment="Center">
                                        <Arc.RenderTransform><RotateTransform /></Arc.RenderTransform>
                                    </Arc>
                                    <TextBlock Text="{l:T Shorten.Busy}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Panel>
                        </Button>

                        <StackPanel Spacing="10" IsVisible="{Binding IsBatchMode}">
                            <Button x:Name="BatchButton" Classes="primary" Classes.busy="{Binding Batch.IsBusy}"
                                    Command="{Binding Batch.ShortenAllCommand}">
                                <Panel>
                                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" IsVisible="{Binding !Batch.IsBusy}">
                                        <TextBlock Text="{l:T Batch.Button}" VerticalAlignment="Center" />
                                        <PathIcon Classes="flip" Data="{StaticResource Icon.ArrowRight}" Width="18" Height="18" Foreground="White" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" IsVisible="{Binding Batch.IsBusy}">
                                        <Arc Classes="spinner" Width="18" Height="18" StartAngle="0" SweepAngle="270"
                                             Stroke="White" StrokeThickness="2.5" StrokeLineCap="Round" VerticalAlignment="Center">
                                            <Arc.RenderTransform><RotateTransform /></Arc.RenderTransform>
                                        </Arc>
                                        <TextBlock Text="{Binding Batch.ProgressText}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Panel>
                            </Button>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" IsVisible="{Binding Batch.IsBusy}">
                                <ProgressBar Value="{Binding Batch.ProgressPercent}" Minimum="0" Maximum="100" VerticalAlignment="Center">
                                    <ProgressBar.Transitions>
                                        <Transitions><DoubleTransition Property="Value" Duration="0:0:0.3" /></Transitions>
                                    </ProgressBar.Transitions>
                                </ProgressBar>
                                <Button Grid.Column="1" Classes="link danger" Content="{l:T Batch.Stop}" Command="{Binding Batch.ShortenAllCancelCommand}" />
                            </Grid>
                        </StackPanel>

                        <Button x:Name="ExpandButton" Classes="primary" Classes.busy="{Binding Expand.IsBusy}"
                                Command="{Binding Expand.ExpandCommand}" IsVisible="{Binding IsExpandMode}">
                            <Panel>
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" IsVisible="{Binding !Expand.IsBusy}">
                                    <TextBlock Text="{l:T Expand.Button}" VerticalAlignment="Center" />
                                    <PathIcon Classes="flip" Data="{StaticResource Icon.ArrowRight}" Width="18" Height="18" Foreground="White" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" IsVisible="{Binding Expand.IsBusy}">
                                    <Arc Classes="spinner" Width="18" Height="18" StartAngle="0" SweepAngle="270"
                                         Stroke="White" StrokeThickness="2.5" StrokeLineCap="Round" VerticalAlignment="Center">
                                        <Arc.RenderTransform><RotateTransform /></Arc.RenderTransform>
                                    </Arc>
                                    <TextBlock Text="{l:T Expand.Busy}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Panel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- ===== Errors ===== -->
                <Border Classes="banner error pop" IsVisible="{Binding HasError}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <PathIcon Data="{StaticResource Icon.Alert}" Width="18" Height="18" VerticalAlignment="Top" />
                        <TextBlock Grid.Column="1" Text="{Binding ErrorMessage}" TextWrapping="Wrap" FontSize="13.5" />
                    </Grid>
                </Border>
                <Border Classes="banner error pop" IsVisible="{Binding Expand.HasError}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <PathIcon Data="{StaticResource Icon.Alert}" Width="18" Height="18" VerticalAlignment="Top" />
                        <TextBlock Grid.Column="1" Text="{Binding Expand.ErrorMessage}" TextWrapping="Wrap" FontSize="13.5" />
                    </Grid>
                </Border>

                <!-- ===== Shorten result ===== -->
                <Border x:Name="ResultCard" Classes="card reveal">
                    <Border.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="HasResult" />
                            <Binding Path="IsShortenMode" />
                        </MultiBinding>
                    </Border.IsVisible>
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Border Width="22" Height="22" CornerRadius="11" Background="{DynamicResource SuccessSoft}">
                                    <PathIcon Data="{StaticResource Icon.Check}" Width="13" Height="13" Foreground="{DynamicResource Success}" />
                                </Border>
                                <TextBlock Text="{l:T Result.Label}" Classes="label" VerticalAlignment="Center" />
                            </StackPanel>
                            <Button Grid.Column="1" Classes="icon" Classes.on="{Binding ShowQr}" Command="{Binding ToggleQrCommand}"
                                    ToolTip.Tip="{l:T Result.QrCode}" AutomationProperties.Name="{l:T Result.QrCode}">
                                <PathIcon Data="{StaticResource Icon.Qr}" />
                            </Button>
                        </Grid>

                        <SelectableTextBlock x:Name="ShortLinkText" Text="{Binding ShortDisplay}" FontSize="28" FontWeight="Bold"
                                             LetterSpacing="-0.4" TextWrapping="Wrap" Foreground="{DynamicResource AccentText}"
                                             FlowDirection="LeftToRight" HorizontalAlignment="Left" />
                        <TextBlock Classes="muted" Text="{Binding ResultLongUrl}" TextTrimming="CharacterEllipsis"
                                   ToolTip.Tip="{Binding ResultLongUrl}" Margin="0,-6,0,0" FlowDirection="LeftToRight" HorizontalAlignment="Left" />
                        <StackPanel Orientation="Horizontal" Spacing="6"
                                    IsVisible="{Binding ResultNote, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <PathIcon Data="{StaticResource Icon.Info}" Width="14" Height="14" Foreground="{DynamicResource Muted}" />
                            <TextBlock Classes="muted small" Text="{Binding ResultNote}" TextWrapping="Wrap" />
                        </StackPanel>

                        <WrapPanel Margin="0,4,0,-8">
                            <Button Classes="soft copy" Classes.copied="{Binding JustCopied}" Command="{Binding CopyResultCommand}"
                                    Margin="0,0,8,8" ToolTip.Tip="Ctrl+Shift+C">
                                <Grid>
                                    <StackPanel Classes="idle" Orientation="Horizontal" Spacing="7">
                                        <PathIcon Data="{StaticResource Icon.Copy}" Width="15" Height="15" />
                                        <TextBlock Text="{l:T Result.Copy}" />
                                    </StackPanel>
                                    <StackPanel Classes="done" Orientation="Horizontal" Spacing="7">
                                        <PathIcon Data="{StaticResource Icon.Check}" Width="15" Height="15" />
                                        <TextBlock Text="{l:T Result.Copied}" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                            <Button Classes="subtle" Command="{Binding OpenResultCommand}" Margin="0,0,8,8">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <PathIcon Data="{StaticResource Icon.Open}" Width="15" Height="15" />
                                    <TextBlock Text="{l:T Result.Open}" />
                                </StackPanel>
                            </Button>
                            <Button Classes="subtle" Command="{Binding ShareResultCommand}" IsVisible="{Binding CanShare}" Margin="0,0,8,8">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <PathIcon Data="{StaticResource Icon.Share}" Width="15" Height="15" />
                                    <TextBlock Text="{l:T Result.Share}" />
                                </StackPanel>
                            </Button>
                        </WrapPanel>

                        <StackPanel Classes="pop" Spacing="8" IsVisible="{Binding ShowQr}" HorizontalAlignment="Center" Margin="0,6,0,0">
                            <Border Background="White" CornerRadius="18" Padding="14" BorderBrush="{DynamicResource Stroke}" BorderThickness="1">
                                <Image Source="{Binding QrCodePng, Converter={x:Static conv:PngBytesToBitmapConverter.Instance}}"
                                       Width="184" Height="184" RenderOptions.BitmapInterpolationMode="None" />
                            </Border>
                            <TextBlock Classes="muted small" HorizontalAlignment="Center" Text="{l:T Result.ScanHint}" />
                            <Button Classes="subtle" HorizontalAlignment="Center" Command="{Binding SaveQrCommand}" Margin="0,2,0,0">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <PathIcon Data="{StaticResource Icon.Save}" Width="15" Height="15" />
                                    <TextBlock Text="{l:T Result.SaveQr}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ===== Batch results ===== -->
                <Border x:Name="BatchResults" Classes="card reveal">
                    <Border.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="Batch.HasResults" />
                            <Binding Path="IsBatchMode" />
                        </MultiBinding>
                    </Border.IsVisible>
                    <StackPanel Spacing="12">
                        <TextBlock Text="{Binding Batch.SummaryText}" Classes="h2" FontSize="15" />
                        <WrapPanel Margin="0,0,0,-8">
                            <Button Classes="soft" Command="{Binding Batch.CopyAllCommand}" Margin="0,0,8,8">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <PathIcon Data="{StaticResource Icon.Copy}" Width="15" Height="15" />
                                    <TextBlock Text="{l:T Batch.CopyAll}" />
                                </StackPanel>
                            </Button>
                            <Button Classes="subtle" Command="{Binding Batch.CopyTableCommand}" Margin="0,0,8,8"
                                    ToolTip.Tip="{l:T Batch.CopyTableTip}">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <PathIcon Data="{StaticResource Icon.Table}" Width="15" Height="15" />
                                    <TextBlock Text="{l:T Batch.CopyTable}" />
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                        <ItemsControl x:Name="BatchList" ItemsSource="{Binding Batch.Results}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Spacing="6" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:BatchItemViewModel">
                                    <Button Classes="row" Padding="10,8" IsEnabled="{Binding IsDone}" ToolTip.Tip="{l:T History.TapToCopy}"
                                            Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).Batch.CopyItemCommand}"
                                            CommandParameter="{Binding}">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                            <Panel Width="22" Height="22" VerticalAlignment="Center">
                                                <Border CornerRadius="11" Background="{DynamicResource SuccessSoft}" IsVisible="{Binding IsDone}">
                                                    <PathIcon Data="{StaticResource Icon.Check}" Width="12" Height="12" Foreground="{DynamicResource Success}" />
                                                </Border>
                                                <Border CornerRadius="11" Background="{DynamicResource DangerSoft}" IsVisible="{Binding IsFailed}">
                                                    <PathIcon Data="{StaticResource Icon.Close}" Width="12" Height="12" Foreground="{DynamicResource Danger}" />
                                                </Border>
                                                <Arc Classes="spinner" Width="16" Height="16" StartAngle="0" SweepAngle="270" IsVisible="{Binding IsWorking}"
                                                     Stroke="{DynamicResource Accent}" StrokeThickness="2" StrokeLineCap="Round">
                                                    <Arc.RenderTransform><RotateTransform /></Arc.RenderTransform>
                                                </Arc>
                                                <Ellipse Width="8" Height="8" Fill="{DynamicResource Stroke}" IsVisible="{Binding IsPending}" />
                                            </Panel>
                                            <StackPanel Grid.Column="1" Spacing="1">
                                                <TextBlock Text="{Binding ShortDisplay}" FontWeight="SemiBold" Foreground="{DynamicResource AccentText}"
                                                           IsVisible="{Binding IsDone}" FlowDirection="LeftToRight" HorizontalAlignment="Left" />
                                                <TextBlock Text="{Binding Input}" Classes="muted small" TextTrimming="CharacterEllipsis"
                                                           FlowDirection="LeftToRight" HorizontalAlignment="Left" />
                                                <TextBlock Text="{Binding ErrorText}" Classes="error" FontSize="12" IsVisible="{Binding IsFailed}" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- ===== Expand result ===== -->
                <Border x:Name="ExpandResult" Classes="card reveal">
                    <Border.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="Expand.HasResult" />
                            <Binding Path="IsExpandMode" />
                        </MultiBinding>
                    </Border.IsVisible>
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border Width="22" Height="22" CornerRadius="11" Background="{DynamicResource AccentSoft}">
                                <PathIcon Classes="flip" Data="{StaticResource Icon.ArrowRight}" Width="13" Height="13" Foreground="{DynamicResource AccentText}" />
                            </Border>
                            <TextBlock Text="{l:T Expand.Label}" Classes="label" VerticalAlignment="Center" />
                        </StackPanel>
                        <SelectableTextBlock x:Name="ExpandHost" Text="{Binding Expand.FinalHost}" FontSize="26" FontWeight="Bold"
                                             LetterSpacing="-0.4" TextWrapping="Wrap" Foreground="{DynamicResource Ink}"
                                             FlowDirection="LeftToRight" HorizontalAlignment="Left" />
                        <SelectableTextBlock Text="{Binding Expand.FinalUrl}" TextWrapping="Wrap" Margin="0,-6,0,0" FontSize="13"
                                             FlowDirection="LeftToRight" HorizontalAlignment="Left" Foreground="{DynamicResource Muted}" />
                        <Border Classes="banner warn pop" IsVisible="{Binding Expand.HasWarning}">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <PathIcon Data="{StaticResource Icon.Alert}" Width="16" Height="16" VerticalAlignment="Top" />
                                <TextBlock Grid.Column="1" Text="{Binding Expand.WarningText}" FontSize="13" TextWrapping="Wrap" />
                            </Grid>
                        </Border>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Classes="muted small" Text="{Binding Expand.RedirectsText}" VerticalAlignment="Center" TextWrapping="Wrap" />
                            <Button Grid.Column="1" Classes="link" Classes.open="{Binding Expand.ShowPath}" Padding="4,0"
                                    Command="{Binding Expand.TogglePathCommand}" IsVisible="{Binding Expand.HasPath}">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="{l:T Expand.ShowPath}" IsVisible="{Binding !Expand.ShowPath}" />
                                    <TextBlock Text="{l:T Expand.HidePath}" IsVisible="{Binding Expand.ShowPath}" />
                                    <PathIcon Classes="chevron" Data="{StaticResource Icon.ChevronDown}" Width="16" Height="16" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <ItemsControl Classes="pop" ItemsSource="{Binding Expand.Path}" IsVisible="{Binding Expand.ShowPath}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Spacing="4" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="sys:String">
                                    <Border Background="{DynamicResource SurfaceAlt}" CornerRadius="10" Padding="10,6">
                                        <SelectableTextBlock Text="{Binding}" FontSize="12.5" TextWrapping="Wrap" FlowDirection="LeftToRight"
                                                             Foreground="{DynamicResource Ink}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <WrapPanel Margin="0,4,0,-8">
                            <Button Classes="soft copy" Classes.copied="{Binding Expand.JustCopied}" Command="{Binding Expand.CopyCommand}" Margin="0,0,8,8">
                                <Grid>
                                    <StackPanel Classes="idle" Orientation="Horizontal" Spacing="7">
                                        <PathIcon Data="{StaticResource Icon.Copy}" Width="15" Height="15" />
                                        <TextBlock Text="{l:T Result.Copy}" />
                                    </StackPanel>
                                    <StackPanel Classes="done" Orientation="Horizontal" Spacing="7">
                                        <PathIcon Data="{StaticResource Icon.Check}" Width="15" Height="15" />
                                        <TextBlock Text="{l:T Result.Copied}" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                            <Button Classes="subtle" Command="{Binding Expand.OpenCommand}" Margin="0,0,8,8">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <PathIcon Data="{StaticResource Icon.Open}" Width="15" Height="15" />
                                    <TextBlock Text="{l:T Result.Open}" />
                                </StackPanel>
                            </Button>
                            <Button Classes="subtle" Command="{Binding Expand.ShortenThisCommand}" Margin="0,0,8,8">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <PathIcon Data="{StaticResource Icon.Link}" Width="15" Height="15" />
                                    <TextBlock Text="{l:T Expand.Shorten}" />
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- ===== History ===== -->
                <StackPanel Spacing="10" Margin="0,6,0,0">
                    <Grid ColumnDefinitions="*,Auto" Margin="2,0">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{l:T History.Title}" Classes="h2" VerticalAlignment="Center" />
                            <Border Background="{DynamicResource AccentSoft}" CornerRadius="10" Padding="8,2"
                                    VerticalAlignment="Center" IsVisible="{Binding !HistoryIsEmpty}">
                                <TextBlock Text="{Binding HistoryCount}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentText}" />
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                            <Button Classes="icon" Command="{Binding ImportHistoryCommand}"
                                    ToolTip.Tip="{l:T History.ImportTip}" AutomationProperties.Name="{l:T History.Import}">
                                <PathIcon Data="{StaticResource Icon.Upload}" />
                            </Button>
                            <Button Classes="icon" Command="{Binding ExportHistoryCommand}" IsVisible="{Binding !HistoryIsEmpty}"
                                    ToolTip.Tip="{l:T History.ExportTip}" AutomationProperties.Name="{l:T History.Export}">
                                <PathIcon Data="{StaticResource Icon.Download}" />
                            </Button>
                            <Button Classes="link danger" Content="{l:T History.ClearAll}" ToolTip.Tip="{l:T History.ClearAllTip}"
                                    Command="{Binding ClearHistoryCommand}" IsVisible="{Binding !HistoryIsEmpty}" />
                        </StackPanel>
                    </Grid>

                    <TextBox Classes="big compact" Text="{Binding HistoryFilter}" PlaceholderText="{l:T History.Search}"
                             IsVisible="{Binding ShowHistorySearch}" Background="{DynamicResource Surface}">
                        <TextBox.InnerLeftContent>
                            <PathIcon Data="{StaticResource Icon.Search}" Width="17" Height="17" Margin="14,0,2,0"
                                      Foreground="{DynamicResource Muted}" />
                        </TextBox.InnerLeftContent>
                    </TextBox>

                    <Border Classes="card" Padding="24" IsVisible="{Binding HistoryIsEmpty}">
                        <StackPanel Spacing="10" HorizontalAlignment="Center">
                            <Border Width="52" Height="52" CornerRadius="26" Background="{DynamicResource AccentSoft}" HorizontalAlignment="Center">
                                <PathIcon Data="{StaticResource Icon.History}" Width="24" Height="24" Foreground="{DynamicResource AccentText}" />
                            </Border>
                            <TextBlock Text="{l:T History.EmptyTitle}" HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" />
                            <TextBlock Classes="muted" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                                       Text="{l:T History.EmptyBody}" />
                        </StackPanel>
                    </Border>

                    <TextBlock Classes="muted" HorizontalAlignment="Center" Margin="0,8" Text="{l:T History.NoMatches}"
                               IsVisible="{Binding NoSearchMatches}" />

                    <ItemsControl x:Name="HistoryList" ItemsSource="{Binding History}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Spacing="8" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:HistoryItemViewModel">
                                <Button Classes="row" Classes.pinned="{Binding Pinned}" ToolTip.Tip="{l:T History.TapToCopy}"
                                        Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).CopyHistoryItemCommand}"
                                        CommandParameter="{Binding}">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <Border Width="40" Height="40" CornerRadius="12" VerticalAlignment="Center"
                                                Background="{Binding Hue, Converter={x:Static conv:HueToBrushConverter.Instance}}">
                                            <TextBlock Text="{Binding Initial}" Foreground="White" FontWeight="Bold" FontSize="16"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                            <TextBlock Text="{Binding ShortDisplay}" FontWeight="SemiBold" FontSize="14.5"
                                                       Foreground="{DynamicResource Ink}" TextTrimming="CharacterEllipsis"
                                                       FlowDirection="LeftToRight" HorizontalAlignment="Left" />
                                            <TextBlock Text="{Binding LongDisplay}" Classes="muted small" TextTrimming="CharacterEllipsis"
                                                       FlowDirection="LeftToRight" HorizontalAlignment="Left" />
                                            <TextBlock Classes="muted" FontSize="11" Opacity="0.85">
                                                <Run Text="{Binding ProviderId}" />
                                                <Run Text=" · " />
                                                <Run Text="{Binding When}" />
                                            </TextBlock>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Classes="icon" Classes.on="{Binding Pinned}" AutomationProperties.Name="{l:T History.Pin}"
                                                    Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).TogglePinCommand}"
                                                    CommandParameter="{Binding}">
                                                <ToolTip.Tip>
                                                    <Panel>
                                                        <TextBlock Text="{l:T History.Pin}" IsVisible="{Binding !Pinned}" />
                                                        <TextBlock Text="{l:T History.Unpin}" IsVisible="{Binding Pinned}" />
                                                    </Panel>
                                                </ToolTip.Tip>
                                                <Panel>
                                                    <PathIcon Data="{StaticResource Icon.PinOutline}" IsVisible="{Binding !Pinned}" />
                                                    <PathIcon Data="{StaticResource Icon.Pin}" IsVisible="{Binding Pinned}" />
                                                </Panel>
                                            </Button>
                                            <Button Classes="icon" ToolTip.Tip="{l:T Result.Open}" AutomationProperties.Name="{l:T Result.Open}"
                                                    Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).OpenHistoryItemCommand}"
                                                    CommandParameter="{Binding}">
                                                <PathIcon Data="{StaticResource Icon.Open}" />
                                            </Button>
                                            <Button Classes="icon" ToolTip.Tip="{l:T Result.Share}" AutomationProperties.Name="{l:T Result.Share}"
                                                    IsVisible="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).CanShare}"
                                                    Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).ShareHistoryItemCommand}"
                                                    CommandParameter="{Binding}">
                                                <PathIcon Data="{StaticResource Icon.Share}" />
                                            </Button>
                                            <Button Classes="icon danger" ToolTip.Tip="{l:T History.Remove}" AutomationProperties.Name="{l:T History.Remove}"
                                                    Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).RemoveHistoryItemCommand}"
                                                    CommandParameter="{Binding}">
                                                <PathIcon Data="{StaticResource Icon.Delete}" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- ===== Toast ===== -->
        <Border x:Name="Toast" Classes="toast" Classes.shown="{Binding IsToastVisible}"
                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="20,0,20,28">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <PathIcon Data="{StaticResource Icon.Check}" Width="15" Height="15" />
                <TextBlock Text="{Binding ToastMessage}" FontSize="13.5" FontWeight="Medium" />
            </StackPanel>
        </Border>
    </Panel>
</UserControl>
