<Project Sdk="Microsoft.NET.Sdk">
  <!-- Android app. Build: dotnet publish -c Release (gives a signed .apk) -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>23</SupportedOSPlatformVersion>
    <RootNamespace>UrlShortener.Android</RootNamespace>
    <ApplicationId>com.bojacnik.urlshortener</ApplicationId>
    <ApplicationTitle>URL Shortener</ApplicationTitle>
    <!-- Must increase with every store/sideload update; the release workflow sets it. -->
    <ApplicationVersion>6</ApplicationVersion>
    <ApplicationDisplayVersion>$(Version)</ApplicationDisplayVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
    <!-- Release trimming makes the SDK add the host's desktop RID (linux-x64) for publish,
         which has no Mono runtime pack and breaks restore. Android picks its own RIDs. -->
    <UseDefaultPublishRuntimeIdentifier>false</UseDefaultPublishRuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Android" />
    <PackageReference Include="Xamarin.AndroidX.Core.SplashScreen" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\UrlShortener.UI\UrlShortener.UI.csproj" />
  </ItemGroup>
</Project>
