<?xml version="1.0" encoding="utf-8" ?>
<resources>
  <style name="MyTheme" />

  <!-- Android 6–11: a static splash made of the background colour and the logo -->
  <style name="MyTheme.NoActionBar" parent="@style/Theme.AppCompat.DayNight.NoActionBar">
    <item name="android:windowActionBar">false</item>
    <item name="android:windowNoTitle">true</item>
    <item name="android:windowBackground">@drawable/splash_screen</item>
  </style>

  <!-- For the text-selection action and the clipboard shortcut: no window, only a toast. -->
  <style name="Theme.Invisible" parent="@android:style/Theme.Translucent.NoTitleBar">
    <item name="android:windowAnimationStyle">@null</item>
    <item name="android:windowNoDisplay">false</item>
  </style>
</resources>
